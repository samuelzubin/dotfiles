{
  /* LEFT */
  "custom/screen-record": {
    "exec": "~/.config/waybar/scripts/screen-record-status",
    "return-type": "json",
    "interval": "once",
    "signal": 6,
    "on-click": "~/.local/bin/screen-record.sh"
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%a, %b %d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },
  "custom/now-playing": {
    "exec": "~/.config/waybar/scripts/now-playing",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
  },
  /* MIDDLE */
  "custom/atlas": {
    "exec": "~/.config/waybar/scripts/atlas-status",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": true
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "●"
    }
  },
  "custom/idle": {
    "exec": "~/.config/waybar/scripts/toggle-idle.sh",
    "return-type": "json",
    "interval": 60,
    "signal": 5,
    "on-click": "~/.config/waybar/scripts/toggle-idle.sh toggle"
  },

  /* RIGHT */
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤫",
    "format-disabled": "󰖪",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "~/.config/waybar/scripts/wifi-menu",
    "on-click-right": "nm-connection-editor",
    "tooltip-format-disconnected": "No Connection",
    "tooltip-format-disabled": "Wi-Fi is OFF",
    "tooltip-format-wifi": "󱄙  {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "󰈀  {ifname} (Connected)\n  {bandwidthDownBytes}   {bandwidthUpBytes}",
    "tooltip-format-linked": "󱘖 {ifname}: No IP Address"
  },
  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth-status",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/bluetooth-menu",
    "on-click-right": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on'"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰁹 100%",
    "states": {
      "warning": 30,
      "critical": 20
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery' 'Battery is at 30%'",
      "on-discharging-critical": "notify-send -u critical 'Low Battery' 'Computer is on life support. Charge it immediately.'"
    },
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "custom/power-profile": {
    "exec": "~/.config/waybar/scripts/power-profile.sh",
    "return-type": "json",
    "interval": 30,
    "on-click": "~/.config/waybar/scripts/power-profile.sh toggle",
    "signal": 4
  }
}
