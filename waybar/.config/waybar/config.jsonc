{
  "layer": "top",
  "position": "top",
  // "height": 40,
  "margin": "6 12 0 12",
  "spacing": 0,
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "clock",
    "custom/now-playing",
    "custom/screen-record"
  ],
  "modules-center": [
    "custom/atlas",
    "niri/workspaces"
  ],
  "modules-right": [
    "network",
    "bluetooth",
    "battery",
    "custom/power-profile",
    "custom/idle"
  ]
}
