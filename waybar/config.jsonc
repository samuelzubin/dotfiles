{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin": "6 510 0 510",
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "custom/screen-record",
    "clock"
  ],
  "modules-center": [
    "custom/atlas",
    "niri/workspaces",
    "custom/idle"
  ],
  "modules-right": [
    "network",
    "bluetooth",
    "battery",
    "custom/power-profile"
  ]
}
