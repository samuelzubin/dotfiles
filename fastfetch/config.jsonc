{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "source": "auto",
    "type": "small",
    "color": {
      "1": "#444559",
      "2": "#e7b9d5"
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 13
    },
    "color": {
      "separator": "#bdc2ff"
    }
  },

  "modules": [
    "break",
    {
      "type": "title",
      "key": "󰋜 user",
      "color": {
        "user": "#bdc2ff",
        "at": "#e4e1e9",
        "host": "#bdc2ff"
      },
     "keyColor": "#bdc2ff" 
    },
    {
      "type": "os",
      "key": "󰌽 os",
      "keyColor": "#bdc2ff",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "󰒓 kernel",
      "keyColor": "#bdc2ff",
      "format": "{release}"
    },

    "break",

    {
      "type": "wm",
      "key": "󱂬 wm",
      "format": "niri",
      "keyColor": "#bdc2ff"
    },
    {
      "type": "shell",
      "key": " shell",
      "format": "bash",
      "keyColor": "#bdc2ff"
    },
    {
      "type": "terminal",
      "key": " terminal",
      "format": "kitty",
      "keyColor": "#bdc2ff"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰍛 cpu",
      "keyColor": "#bdc2ff"
    },
    {
      "type": "memory",
      "key": " memory",
      "keyColor": "#bdc2ff"
    },
    {
      "type": "disk",
      "key": "󰋊 disk",
      "keyColor": "#bdc2ff",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },

    "break",

    {
      "type": "terminalfont",
      "key": " font",
      "keyColor": "#bdc2ff",
      "format": "{name}"
    },
    {
      "type": "uptime",
      "key": "󰥔 uptime",
      "keyColor": "#bdc2ff"
    },
    {
      "type": "colors",
      "key": "󰏘 colors",
      "keyColor": "#bdc2ff",
      "symbol": "circle"
    }
  ]
}
