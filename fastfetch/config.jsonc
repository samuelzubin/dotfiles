{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "source": "Fedora",
    "color": {
      "1": "#182e60",
      "2": "#b2c5ff"
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 14
    },
    "color": {
      "separator": "#b2c5ff"
    }
  },

  "modules": [
    "break",

    {
      "type": "title",
      "color": {
        "user": "#b2c5ff",
        "at": "#e3e2e9",
        "host": "#b2c5ff"
      }
    },

    "break",

    {
      "type": "os",
      "key": " System",
      "keyColor": "#b2c5ff"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "#b2c5ff"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "#b2c5ff"
    },

    "break",

    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "#b2c5ff"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#b2c5ff"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "#b2c5ff"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "#b2c5ff"
    },
    {
      "type": "memory",
      "key": " Memory",
      "keyColor": "#b2c5ff"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "#b2c5ff"
    },

    "break",

    {
      "type": "terminalfont",
      "key": " Font",
      "keyColor": "#b2c5ff"
    },
    {
      "type": "uptime",
      "key": "󰥔 Uptime",
      "keyColor": "#b2c5ff"
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
