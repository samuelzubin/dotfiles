{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "fedora_small",
    "padding": { "top": 3 },
    "color": { "1": "#c6bfff", "2": "#e4dfff" }
  },
  "display": {
    "separator": "",
    "size": { "binaryPrefix": "jedec", "ndigits": 1 },
    "color": "38;2;228;223;255",
    "percent": { "type": 1 },
    "constants": [
      "\u001b[38;2;198;191;255m",   /* $1: icon color (matugen primary) */
      "\u001b[38;2;228;223;255m",   /* $2: key + value text (matugen primary_fixed, a lighter tint of $1) */
      "\u001b[38;2;146;143;153m"    /* $3: box border (matugen outline) */
    ]
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "{$3}╭──────────────────────────────────────────────╮"
    },
    {
      "type": "command",
      "shell": "bash",
      "param": "-c",
      "text": "printf '%34s' \"$USER@$(uname -n)\"",
      "key": "{$3}│ {$1}󰋜{$2} user    ",
      "format": "{$1}{result}{$3} │"
    },
    {
      "type": "os",
      "key": "{$3}│ {$1}󰌽{$2} os      ",
      "format": "{$2}{name>34}{$3} │"
    },
    {
      "type": "kernel",
      "key": "{$3}│ {$1}󰒓{$2} kernel  ",
      "format": "{$2}{release>34}{$3} │"
    },
    {
      "type": "wm",
      "key": "{$3}│ {$1}󱂬{$2} wm      ",
      "format": "{$2}{pretty-name>34}{$3} │"
    },
    {
      "type": "shell",
      "key": "{$3}│ {$1}{$2} shell   ",
      "format": "{$2}{process-name>34}{$3} │"
    },
    {
      "type": "terminal",
      "key": "{$3}│ {$1}{$2} terminal",
      "format": "{$2}                             kitty{$3} │"
    },
    {
      "type": "cpu",
      "key": "{$3}│ {$1}󰍛{$2} cpu     ",
      "format": "{$2}{name>34}{$3} │"
    },
    {
      "type": "memory",
      "key": "{$3}│ {$1}{$2} memory  ",
      "format": "           {$2}{used>7} / {total>7} ({percentage>3}){$3} │"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "{$3}│ {$1}󰋊{$2} disk    ",
      "format": "         {$2}{size-used>8} / {size-total>8} ({size-percentage>3}){$3} │"
    },
    {
      "type": "terminalfont",
      "key": "{$3}│ {$1}{$2} font    ",
      "format": "{$2}{name>34}{$3} │"
    },
    {
      "type": "uptime",
      "key": "{$3}│ {$1}󰥔{$2} uptime  ",
      "format": "{$2}{formatted>34}{$3} │"
    },
    {
      "type": "custom",
      "key": "{$3}│ {$1}󰏘{$2} colors  ",
      "format": "                   \u001b[30m● \u001b[31m● \u001b[32m● \u001b[33m● \u001b[34m● \u001b[35m● \u001b[36m● \u001b[37m●{$3} │"
    },
    {
      "type": "custom",
      "key": "{$3}╰──────────────────────────────────────────────╯"
    },
    "break"
  ]
}
