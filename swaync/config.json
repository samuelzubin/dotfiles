{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 7,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 350,
  "control-center-height": 798,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "scripts": {
    "battery-id-tracker-summary": {
      "summary": "(?i)batter",
      "exec": "echo $SWAYNC_ID >> $XDG_RUNTIME_DIR/swaync-battery-ids"
    },
    "battery-id-tracker-body": {
      "body": "(?i)batter",
      "exec": "echo $SWAYNC_ID >> $XDG_RUNTIME_DIR/swaync-battery-ids"
    }
  },
  "widgets": [
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "mpris": {
      "image-size": 60,
      "image-radius": 50
    },
    "volume": {
      "label": "󰕾 ",
      "expand-button-label": " ",
      "collapse-button-label": " ",
      "show-per-app": true,
      "show-per-app-icon": true,
      "empty-list-label": ""
    },
    "backlight": {
      "label": "󰃟 ",
      "device": "amdgpu_bl1"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": " ",
          "type": "toggle",
          "command": "[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off",
          "update-command": "[[ $(nmcli radio wifi) == enabled ]] && echo true || echo false"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "command": "[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off",
          "update-command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
        }
      ]
    }
  }
}
