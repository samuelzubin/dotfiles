blur {
  passes 4
  offset 8
  noise 0.005
  saturation 1.8
}
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

environment {
  ELECTRON_OZONE_PLATFORM_HINT "auto"

  // Keep apps on the AMD iGPU so the NVIDIA dGPU can runtime-suspend (battery).
  // eDP-1 and HDMI-A-1 are both wired to the AMD GPU.
  // To run something on the NVIDIA GPU use: switcherooctl launch -g 1 <cmd>
  // (or set the vars below to their old nvidia values for that command).
  __GLX_VENDOR_LIBRARY_NAME "mesa"
  __EGL_VENDOR_LIBRARY_FILENAMES "/usr/share/glvnd/egl_vendor.d/50_mesa.json"
  VK_LOADER_DRIVERS_DISABLE "*nvidia*"
  LIBVA_DRIVER_NAME "radeonsi"
  // previous (always-nvidia) setting:
  // __GLX_VENDOR_LIBRARY_NAME "nvidia"
  // LIBVA_DRIVER_NAME "nvidia"
}

debug {
  // Don't open the NVIDIA dGPU (so it can runtime-suspend and save battery).
  // Side effect: the USB-C DisplayPort output (wired to the dGPU) is unavailable.
  // Built-in panel and HDMI are on the AMD GPU and are unaffected.
  // Delete this block to get USB-C DP back.
  ignore-drm-device "/dev/dri/by-path/pci-0000:01:00.0-card"
}
