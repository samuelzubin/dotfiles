// Mod+Shift+/ shows these. Binds appear in the order they are listed here.
// hotkey-overlay-title="..." names a bind there; =null hides it.
binds {
    // ── Apps ─────────────────────────────────────────────────────────────
    Mod+Return  hotkey-overlay-title="Open Terminal"       { spawn "kitty"; }
    Mod+D       hotkey-overlay-title="App Launcher"        { spawn "rofi" "-show" "drun"; }
    Mod+Tab     hotkey-overlay-title="Window Switcher"     { spawn "~/.config/rofi/scripts/window-switcher"; }
    Mod+E       hotkey-overlay-title="File Manager"        { spawn "env" "GSK_RENDERER=gl" "GDK_DISABLE_VULKAN=1" "nautilus" "--new-window"; }
    Mod+N       hotkey-overlay-title="Notification Center" { spawn "sh" "-c" "swaync-client -rs && swaync-client -t"; }
    Mod+Shift+N hotkey-overlay-title="Quick Note"          { spawn "~/.config/swaync/scripts/quick-note.sh"; }
    Mod+Shift+W hotkey-overlay-title="Wallpaper Picker"    { spawn "wallselect"; }

    // ── Niri ─────────────────────────────────────────────────────────────
    Mod+Shift+Slash hotkey-overlay-title="Show Hotkeys"       { show-hotkey-overlay; }
    Super+Alt+L     hotkey-overlay-title="Lock Screen"        { spawn "hyprlock"; }
    Mod+Shift+Q     hotkey-overlay-title="Power Menu" repeat=false { spawn "wlogout"; }
    Mod+Shift+E     hotkey-overlay-title="Quit Niri"          { quit; }
    Mod+Shift+P     hotkey-overlay-title="Turn Off Monitors"  { power-off-monitors; }
    Ctrl+Alt+Delete hotkey-overlay-title=null                 { quit; }
    Mod+Escape      hotkey-overlay-title=null allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Use spawn-sh to run a shell command. Do this if you need pipes, multiple commands, etc.
    // Note: the entire command goes as a single argument. It's passed verbatim to `sh -c`.
    // For example, this is a standard bind to toggle the screen reader (orca).
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // ── Windows ──────────────────────────────────────────────────────────
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }

    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+M            { maximize-window-to-edges; }
    Mod+C            { center-column; }
    Mod+Ctrl+C       { center-visible-columns; }
    Mod+Ctrl+F       { expand-column-to-available-width; }
    Mod+V            { toggle-window-floating; }
    Mod+Shift+V      { switch-focus-between-floating-and-tiling; }
    Mod+W            { toggle-column-tabbed-display; }

    // Window sizing
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }
    Mod+Minus        { set-column-width "-5%"; }
    Mod+Equal        { set-column-width "+5%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }

    // Columns
    Mod+BracketLeft  hotkey-overlay-title=null { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title=null { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // ── Navigation ───────────────────────────────────────────────────────
    Mod+H     hotkey-overlay-title="Focus Window Left (or ←)"  { focus-column-left; }
    Mod+L     hotkey-overlay-title="Focus Window Right (or →)" { focus-column-right; }
    Mod+J     hotkey-overlay-title="Focus Workspace Down (or ↓)"  { focus-window-or-workspace-down; }
    Mod+K     hotkey-overlay-title="Focus Workspace Up (or ↑)"    { focus-window-or-workspace-up; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Alternate navigation commands
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+U     hotkey-overlay-title=null { focus-window-down; }
    Mod+I     hotkey-overlay-title=null { focus-window-up; }

    // ── Window Organization ──────────────────────────────────────────────
    Mod+Ctrl+H     hotkey-overlay-title="Move Left (or ←)"  { move-column-left; }
    Mod+Ctrl+J     hotkey-overlay-title="Move Down (or ↓)"  { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K     hotkey-overlay-title="Move Up (or ↑)"    { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+L     hotkey-overlay-title="Move Right (or →)" { move-column-right; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // Alternate organization commands
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Ctrl+U     hotkey-overlay-title=null { move-window-down; }
    Mod+Ctrl+I     hotkey-overlay-title=null { move-window-up; }

    // ── Monitors ─────────────────────────────────────────────────────────
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // ── Workspaces ───────────────────────────────────────────────────────
    // Only Mod+1 and Mod+Ctrl+1 are listed in the overlay, titled as ranges.
    Mod+1 hotkey-overlay-title="Go to Workspace 1–9"           { focus-workspace 1; }
    Mod+2 hotkey-overlay-title=null { focus-workspace 2; }
    Mod+3 hotkey-overlay-title=null { focus-workspace 3; }
    Mod+4 hotkey-overlay-title=null { focus-workspace 4; }
    Mod+5 hotkey-overlay-title=null { focus-workspace 5; }
    Mod+6 hotkey-overlay-title=null { focus-workspace 6; }
    Mod+7 hotkey-overlay-title=null { focus-workspace 7; }
    Mod+8 hotkey-overlay-title=null { focus-workspace 8; }
    Mod+9 hotkey-overlay-title=null { focus-workspace 9; }
    Mod+Ctrl+1 hotkey-overlay-title="Move Column to Workspace 1–9" { move-column-to-workspace 1; }
    Mod+Ctrl+2 hotkey-overlay-title=null { move-column-to-workspace 2; }
    Mod+Ctrl+3 hotkey-overlay-title=null { move-column-to-workspace 3; }
    Mod+Ctrl+4 hotkey-overlay-title=null { move-column-to-workspace 4; }
    Mod+Ctrl+5 hotkey-overlay-title=null { move-column-to-workspace 5; }
    Mod+Ctrl+6 hotkey-overlay-title=null { move-column-to-workspace 6; }
    Mod+Ctrl+7 hotkey-overlay-title=null { move-column-to-workspace 7; }
    Mod+Ctrl+8 hotkey-overlay-title=null { move-column-to-workspace 8; }
    Mod+Ctrl+9 hotkey-overlay-title=null { move-column-to-workspace 9; }

    Mod+Shift+Page_Down hotkey-overlay-title=null { move-workspace-down; }
    Mod+Shift+Page_Up   hotkey-overlay-title=null { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // ── Screenshot / screen record ───────────────────────────────────────
    Print      { screenshot show-pointer=false; }
    Ctrl+Print { screenshot-screen show-pointer=false; }
    Alt+Print  { screenshot-window show-pointer=false; }
    Mod+Print  hotkey-overlay-title="Record Screen" { spawn "~/.local/bin/screen-record.sh"; }

    // ── Mouse ────────────────────────────────────────────────────────────
    Mod+WheelScrollDown      cooldown-ms=150 hotkey-overlay-title=null { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 hotkey-overlay-title=null { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 hotkey-overlay-title=null { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title=null { move-column-to-workspace-up; }

    Mod+WheelScrollRight      hotkey-overlay-title=null { focus-column-right; }
    Mod+WheelScrollLeft       hotkey-overlay-title=null { focus-column-left; }
    Mod+Ctrl+WheelScrollRight hotkey-overlay-title=null { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  hotkey-overlay-title=null { move-column-left; }

    Mod+Shift+WheelScrollDown      hotkey-overlay-title=null { focus-column-right; }
    Mod+Shift+WheelScrollUp        hotkey-overlay-title=null { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown hotkey-overlay-title=null { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   hotkey-overlay-title=null { move-column-left; }

    // ── Media keys ───────────────────────────────────────────────────────
    // Volume
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title=null { spawn "swayosd-client" "--output-volume" "raise" "--max-volume" "180"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title=null { spawn "swayosd-client" "--output-volume" "lower" "--max-volume" "180"; }
    XF86AudioMute        allow-when-locked=true hotkey-overlay-title=null { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute     allow-when-locked=true hotkey-overlay-title=null { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    XF86Launch1          allow-when-locked=true hotkey-overlay-title=null { spawn-sh "playerctl play-pause"; }

    // Microphone volume
    "Shift+XF86AudioRaiseVolume" allow-when-locked=true hotkey-overlay-title=null { spawn "swayosd-client" "--input-volume" "raise" "--max-volume" "100"; }
    "Shift+XF86AudioLowerVolume" allow-when-locked=true hotkey-overlay-title=null { spawn "swayosd-client" "--input-volume" "lower" "--max-volume" "100"; }

    // Media
    XF86AudioPlay        allow-when-locked=true hotkey-overlay-title=null { spawn-sh "playerctl play"; }
    XF86AudioPause       allow-when-locked=true hotkey-overlay-title=null { spawn-sh "playerctl pause"; }
    XF86AudioStop        allow-when-locked=true hotkey-overlay-title=null { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true hotkey-overlay-title=null { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true hotkey-overlay-title=null { spawn-sh "playerctl next"; }

    // Brightness
    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title=null { spawn "swayosd-client" "--brightness" "+5"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title=null { spawn "swayosd-client" "--brightness" "-5"; }
}
