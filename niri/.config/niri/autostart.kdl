spawn-at-startup "swww-daemon"
spawn-at-startup "sh" "-c" "sleep 1 && swww img ~/.config/current_wallpaper"
spawn-at-startup "hypridle"
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "/home/samuel/.config/swaync/scripts/battery-ac-dismiss.sh"
spawn-at-startup "/home/samuel/.config/swaync/scripts/button-labels.sh"
spawn-at-startup "flatpak" "run" "md.obsidian.Obsidian"

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
  // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
  skip-at-startup

  hide-not-bound
}
