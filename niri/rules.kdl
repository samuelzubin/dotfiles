// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
  // This regular expression is intentionally made as specific as possible,
  // since this is the default config, and we want no false positives.
  // You can get away with just app-id="wezterm" if you want.
  match app-id=r#"^org\.wezfurlong\.wezterm$"#
  default-column-width {}
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
  // This app-id regular expression will work for both:
  // - host Firefox (app-id is "firefox")
  // - Flatpak Firefox (app-id is "org.mozilla.firefox")
  match app-id=r#"firefox$"# title="^Picture-in-Picture$"
  open-floating true
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
  match app-id=r#"^org\.keepassxc\.KeePassXC$"#
  match app-id=r#"^org\.gnome\.World\.Secrets$"#

  block-out-from "screen-capture"

  // Use this instead if you want them visible on third-party screenshot tools.
  // block-out-from "screencast"
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
window-rule {
  geometry-corner-radius 16
  clip-to-geometry true
}

window-rule {
  match app-id="brave-browser"
  match app-id="discord"
  match app-id="Spotify"
  match app-id="steam"
  match app-id="io.github.alainm23.planify"
  match app-id="spotify-player"
  match app-id="^spotify-player-bg$"
  match app-id="firefox"
  match app-id="code"
  match app-id="md.obsidian.Obsidian"
  // Editors Atlas opens for a project (atlas/tools/projects.py spawns
  // kitty with this title). Matched on title, not a custom app-id, so
  // these windows still match the ^kitty$ blur rule below — and so
  // ordinary terminals keep the default half-width column.
  match app-id="^kitty$" title="^atlas project$"
  open-maximized true
}

window-rule {
  match app-id="^kitty$"
  match app-id="spotify-player"
  match app-id="^spotify-player-bg$"
  background-effect {
    blur true
  }
}

window-rule {
  match app-id="^spotify-player-bg$"
  open-focused false
}

window-rule {
  match app-id="^float-term$"
  open-floating true
  background-effect {
    blur true
    xray false
  }

  default-window-height { proportion 0.90; }
  default-column-width  { proportion 0.45; }
}

window-rule {
  match app-id="org.gnome.Calculator"
  open-floating true
  default-window-height { proportion 0.65; }
  default-column-width  { proportion 0.18; }
  default-floating-position x=1140 y=185
}

layer-rule {
  match namespace="^rofi$"
  match namespace="waybar"
  match namespace="^swaync-control-center$"
  geometry-corner-radius 28
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="swayosd"
  geometry-corner-radius 32
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="^logout_dialog$"
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="swww"
  place-within-backdrop true
}
