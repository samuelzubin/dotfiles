/* Theme for the niri window switcher (scripts/window-switcher, Mod+Tab).
   The app launcher keeps using config.rasi.

   Built from the rest of the desktop:
   - panel + search box: same as config.rasi (dark glass, 18px, 2px primary input)
   - cards: same as waybar blocks (translucent surface, thin outline, 16px)
   - selected card: niri's focus ring (2px primary, 16px window corners)
   The script sets columns/width to fit the number of open windows. */
@import "colors.rasi"

configuration {
  font: "JetBrainsMono NF 12";
  show-icons: true;
  /* Fallback for apps whose .desktop icon isn't in hicolor. */
  icon-theme: "breeze-dark";
  /* Tab / Shift+Tab / arrows step through the cards. */
  kb-element-next: "Tab,Right";
  kb-element-prev: "ISO_Left_Tab,Left";
  /* Left/Right drive the cards, so drop them from text-cursor movement. */
  kb-move-char-back: "Control+b";
  kb-move-char-forward: "Control+f";
}

* {
  background-color: transparent;
  text-color: @on-surface;
}

window {
  location: center;
  anchor: center;
  padding: 22px;
  border: 0px;
  border-radius: 18px;
  background-color: #00000070;
}

mainbox {
  spacing: 16px;
  children: [ "inputbar", "listview" ];
}

/* ---- SEARCH (title + count live inside the bar, like a waybar block) ---- */
inputbar {
  spacing: 10px;
  padding: 10px 14px;
  border: 2px;
  border-radius: 14px;
  border-color: @primary;
  children: [ "textbox-search-icon", "entry", "num-filtered-rows", "textbox-count-suffix" ];
}

textbox-search-icon {
  expand: false;
  content: "󰍉";
  text-color: @primary;
  vertical-align: 0.5;
}

entry {
  placeholder: "Switch window";
  placeholder-color: @outline;
  cursor-color: @primary;
  vertical-align: 0.5;
}

num-filtered-rows,
textbox-count-suffix {
  expand: false;
  vertical-align: 0.5;
  font: "JetBrainsMono NF 10";
  text-color: @outline;
}

textbox-count-suffix {
  content: "open";
}

/* ---- CARDS ---- */
listview {
  lines: 1;
  spacing: 10px;
  scrollbar: false;
  fixed-columns: true;
  fixed-height: true;
  dynamic: false;
  cycle: true;
}

element {
  orientation: vertical;
  spacing: 10px;
  padding: 16px 10px 12px;
  border: 1px;
  border-radius: 16px;
  border-color: @border-soft;
  background-color: @field;
  children: [ "element-icon", "element-text" ];
}

element normal.normal,
element alternate.normal {
  background-color: @field;
  text-color: @on-surface;
}

/* niri focus ring */
element selected.normal {
  border: 2px;
  border-color: @primary;
  background-color: @selected;
  text-color: @primary;
}

element-icon {
  size: 52px;
  horizontal-align: 0.5;
}

element-text {
  horizontal-align: 0.5;
  vertical-align: 0;
  text-color: inherit;
  highlight: bold;
}
