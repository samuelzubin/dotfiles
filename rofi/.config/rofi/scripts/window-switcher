#!/usr/bin/env python3
# Window switcher for niri: rofi list of open windows, most recently focused
# first, with icons resolved through .desktop files (rofi's built-in window
# mode guesses icons from the raw app_id, which fails for flatpaks/Electron).
import json
import os
import subprocess
from html import escape
from pathlib import Path

THEME = Path.home() / ".config/rofi/window.rasi"

# Must agree with window.rasi (element spacing / window padding).
CARD_W, CARD_GAP, PANEL_PAD = 150, 10, 22
MAX_COLS, MIN_W = 6, 460


def desktop_entries():
    """Map lowercased app_id candidates -> (Name, Icon) from .desktop files."""
    dirs = [os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))]
    dirs += os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    found = {}
    for d in reversed(dirs):  # earlier dirs take precedence, so apply them last
        appdir = Path(d) / "applications"
        if not appdir.is_dir():
            continue
        for f in appdir.glob("*.desktop"):
            fields = {}
            in_main = False
            try:
                for line in f.read_text(errors="ignore").splitlines():
                    if line.startswith("["):
                        in_main = line.strip() == "[Desktop Entry]"
                    elif in_main and "=" in line:
                        k, v = line.split("=", 1)
                        fields.setdefault(k.strip(), v.strip())
            except OSError:
                continue
            entry = (fields.get("Name", ""), fields.get("Icon", ""))
            for key in (f.stem, fields.get("StartupWMClass", "")):
                if key:
                    found[key.lower()] = entry
    return found


def niri(*args):
    return json.loads(subprocess.run(["niri", "msg", "-j", *args], capture_output=True, text=True, check=True).stdout)


def main():
    windows = niri("windows")
    if not windows:
        return
    ws_idx = {w["id"]: w["idx"] for w in niri("workspaces")}
    apps = desktop_entries()

    def recency(w):
        ts = w.get("focus_timestamp") or {}
        return (ts.get("secs", 0), ts.get("nanos", 0))

    windows.sort(key=recency, reverse=True)

    rows = []
    for w in windows:
        app_id = w.get("app_id") or ""
        name, icon = apps.get(app_id.lower(), ("", ""))
        name = name or app_id or "Window"
        icon = icon or app_id.lower()
        title = w.get("title") or ""
        ws = ws_idx.get(w.get("workspace_id"))
        sub = f"{ws} · {title}" if ws else title
        text = f"{escape(name)}\n<span size='small' alpha='60%'>{escape(sub)}</span>"
        rows.append(f"{text}\0icon\x1f{icon}\x1fmeta\x1f{escape(app_id)} {escape(title)}")

    # Alt-Tab style: the current window is first, so preselect the previous one.
    selected = "1" if len(windows) > 1 and windows[0].get("is_focused") else "0"

    # Size the strip to the window count: up to MAX_COLS cards, then it scrolls.
    cols = min(len(windows), MAX_COLS)
    width = max(cols * CARD_W + (cols - 1) * CARD_GAP + 2 * PANEL_PAD, MIN_W)
    fit = f"window {{ width: {width}px; }} listview {{ columns: {cols}; }}"
    res = subprocess.run(
        # Rows are two lines (app + title), so separate rows with \x1e instead of \n.
        ["rofi", "-dmenu", "-i", "-markup-rows", "-sep", "\x1e", "-eh", "2", "-format", "i", "-p", "Windows",
         "-selected-row", selected, "-theme", str(THEME), "-theme-str", fit],
        input="\x1e".join(rows), capture_output=True, text=True,
    )
    choice = res.stdout.strip()
    if res.returncode == 0 and choice.isdigit():
        subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(windows[int(choice)]["id"])])


if __name__ == "__main__":
    main()
